{
  "name": "drama-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "admin:bootstrap": "pnpm --filter @drama/api admin:bootstrap",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @drama/api db:migrate",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "permissions:sync": "pnpm --filter @drama/api permissions:sync",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "worker": "pnpm --filter @drama/api worker",
    "worker:app-build": "pnpm --filter @drama/api worker:app-build"
  }
}
