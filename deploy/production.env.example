# 镜像可以替换为已推送到私有仓库的固定版本，禁止使用不确定的 latest。
DRAMA_WEB_API_IMAGE=registry.example.com/drama/web-api:0.1.0
DRAMA_WORKER_IMAGE=registry.example.com/drama/worker:0.1.0
DRAMA_ADMIN_API_IMAGE=registry.example.com/drama/admin-api:0.1.0
DRAMA_AGENT_API_IMAGE=registry.example.com/drama/agent-api:0.1.0
DRAMA_PLATFORM_ADMIN_IMAGE=registry.example.com/drama/platform-admin:0.1.0
DRAMA_TENANT_ADMIN_IMAGE=registry.example.com/drama/tenant-admin:0.1.0
DRAMA_WEB_STATIC_IMAGE=registry.example.com/drama/web-static:0.1.0

# 三个最小权限 PostgreSQL 运行角色必须不同；migration 账号只用于发布步骤。
DATABASE_URL=postgresql://tenant_api:replace@db.example.com:5432/drama
PLATFORM_DATABASE_URL=postgresql://platform_api:replace@db.example.com:5432/drama
TENANT_RESOLVER_DATABASE_URL=postgresql://resolver_api:replace@db.example.com:5432/drama
DATABASE_MIGRATION_URL=postgresql://migration_owner:replace@db.example.com:5432/drama
DATABASE_SSL_CA_BASE64=replace-with-base64-ca-certificate
DATABASE_POOL_MAX=10
# Per connection, milliseconds. Do not disable limits; tune against measured workloads.
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
REDIS_URL=rediss://default:replace@redis.example.com:6379

PLATFORM_ADMIN_HOSTS=admin.example.com
PLATFORM_TENANT_BASE_DOMAIN=app.example.com
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-bytes
CUSTOMER_OTP_HMAC_SECRET=replace-with-at-least-32-random-bytes
CUSTOMER_UNIVERSAL_OTP_ENABLED=false
ALLOW_INSECURE_OTP=false

# 每项都是 {"1":"<32-byte-base64-key>"}，各域必须使用不同密钥。
STORAGE_CREDENTIAL_MASTER_KEYS={"1":"replace-with-32-byte-base64-key"}
STORAGE_ACTIVE_KEY_VERSION=1
STORAGE_ENDPOINT_HOST_ALLOWLIST=
FINANCE_PAYOUT_MASTER_KEYS={"1":"replace-with-32-byte-base64-key"}
FINANCE_PAYOUT_ACTIVE_KEY_VERSION=1
PAYMENT_MASTER_KEYS={"1":"replace-with-32-byte-base64-key"}
PAYMENT_ACTIVE_KEY_VERSION=1
NOTIFICATION_MASTER_KEYS={"1":"replace-with-32-byte-base64-key"}
NOTIFICATION_ACTIVE_KEY_VERSION=1
COMMUNICATION_MASTER_KEYS={"1":"replace-with-32-byte-base64-key"}
COMMUNICATION_ACTIVE_KEY_VERSION=1

PLATFORM_ADMIN_PORT=8081
TENANT_ADMIN_PORT=8082
H5_PORT=8083
WORKER_ID=single-server-worker-1

# 通用 API/Worker 永远保持关闭。应用构建在独立构建机使用单独环境文件启动。
APP_BUILD_WORKER_ENABLED=false
APP_BUILD_EXECUTOR=disabled
