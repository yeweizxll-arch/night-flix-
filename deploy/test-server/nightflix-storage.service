[Unit]
Description=Night Flix isolated test disk storage (SeaweedFS 4.45)
After=network.target

[Service]
User=nightflix-storage
Group=nightflix-storage
StateDirectory=nightflix-storage
StateDirectoryMode=0700
WorkingDirectory=/var/lib/nightflix-storage
LoadCredential=s3.json:/etc/nightflix/storage-s3.private.json
Environment=GOMEMLIMIT=768MiB
ExecStart=/opt/nightflix/runtime/seaweedfs-4.45/weed mini -dir=/var/lib/nightflix-storage -ip=127.0.0.1 -ip.bind=127.0.0.1 -s3.config=%d/s3.json -bucket=nightflix-public,nightflix-demo -s3.port=8333 -s3.iam=false -s3.autoCreateBucket=false -s3.allowDeleteBucketNotEmpty=false -s3.externalUrl=https://47.110.245.29 -s3.allowedOrigins=https://47.110.245.29,https://47.110.245.29:9441,https://47.110.245.29:9442 -s3.port.iceberg=0 -s3.port.lance=0 -s3.concurrentFileUploadLimit=4 -filer.concurrentUploadLimitMB=128 -webdav=false -admin.ui=false -master.telemetry=false
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
MemoryMax=1G
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
