NODE_ENV=development
PORT=3000
PLATFORM_ADMIN_HOSTS=localhost,127.0.0.1
PLATFORM_TENANT_BASE_DOMAIN=tenant.localhost
TRUST_PROXY=false

# 临时开发期域名目录。进入数据库阶段后由 tenant_domains 表替代。
# 仅允许配置已验证域名，不接受客户端任意 tenant_id 请求头。
TENANT_DOMAIN_MAP={"demo.localhost":"00000000-0000-0000-0000-000000000001"}

# 数据库、Redis 与对象存储。
DATABASE_URL=postgresql://drama:change-me@127.0.0.1:5432/drama_saas
DATABASE_MIGRATION_URL=postgresql://drama_owner:change-me@127.0.0.1:5432/drama_saas
PLATFORM_DATABASE_URL=postgresql://drama_platform:change-me@127.0.0.1:5432/drama_saas
TENANT_RESOLVER_DATABASE_URL=postgresql://drama_resolver:change-me@127.0.0.1:5432/drama_saas
DATABASE_POOL_MAX=10
DATABASE_SSL=disable
# 生产必须设为 verify-full；私有CA按Base64提供。
DATABASE_SSL_CA_BASE64=
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-bytes
AUTH_SCRYPT_CONCURRENCY=4
AUTH_SCRYPT_QUEUE_MAX=100

# 终端用户验证码。生产的 HMAC secret 至少 32 字节。
CUSTOMER_OTP_HMAC_SECRET=
CUSTOMER_OTP_EXPOSE_CODE=false
CUSTOMER_UNIVERSAL_OTP_ENABLED=false
# 仅当产品负责人明确接受上线期万能码风险时才与上一项同时开启。
ALLOW_INSECURE_OTP=false

# 对象存储凭据主密钥是 {"版本":"32字节Base64密钥"} JSON。
# 可用 `openssl rand -base64 32` 生成；生产必填，且应交给密钥管理服务注入。
STORAGE_CREDENTIAL_MASTER_KEYS=
STORAGE_ACTIVE_KEY_VERSION=
# 生产使用自定义 S3 兼容 endpoint 时必填，逗号分隔，可用 *.example.com。
STORAGE_ENDPOINT_HOST_ALLOWLIST=

# 提现收款账户 AES-256-GCM 密钥环，格式同对象存储主密钥。
# 生产必填；旧版本密钥保留到相关提现记录超过法定留存期。
FINANCE_PAYOUT_MASTER_KEYS=
FINANCE_PAYOUT_ACTIVE_KEY_VERSION=

# Stripe secretKey / webhookSecret AES-256-GCM 密钥环，每个收款账号、模式和版本均用 AAD 隔离。
# 生产必填；旧版本主密钥至少保留到 webhook secret 30 天轮换宽限结束。
PAYMENT_MASTER_KEYS=
PAYMENT_ACTIVE_KEY_VERSION=

# Push device token / APNs / FCM 凭据 AES-256-GCM 密钥环。每个商家凭据用 AAD 隔离。
# 生产启用通知时必填；不要与 storage / finance 共用密钥。
NOTIFICATION_MASTER_KEYS=
NOTIFICATION_ACTIVE_KEY_VERSION=

# 商家 Resend / Twilio 凭据及短期 OTP 投递载荷 AES-256-GCM 密钥环。
# 生产必填；不要与 storage / finance / notification 共用密钥，旧版本需保留至队列清空。
COMMUNICATION_MASTER_KEYS=
COMMUNICATION_ACTIVE_KEY_VERSION=

OUTBOX_BATCH_SIZE=50
OUTBOX_STREAM_KEY=drama:events
SCHEDULE_BATCH_SIZE=50
WORKER_POLL_INTERVAL_MS=500
# 多 Worker 部署时每个实例必须唯一；留空则使用 hostname:pid。
WORKER_ID=

# 原生应用构建必须运行在独立、受信任的构建机，不要在 API 或普通业务 Worker 内开启。
# 默认关闭；构建机同时设置 enabled=true、executor=local 才会领取任务。
APP_BUILD_WORKER_ENABLED=false
APP_BUILD_EXECUTOR=disabled
APP_BUILD_POLL_INTERVAL_MS=2000
# 构建产物只能写入一个 active 的平台 S3 provider。
APP_BUILD_ARTIFACT_STORAGE_PROVIDER_ID=
# 下面路径必须是构建机上的绝对路径；Gradle/Xcode 依赖需要提前缓存，构建过程禁止联网解析依赖。
APP_BUILD_TEMPLATE_ROOT=
APP_BUILD_TMP_ROOT=
APP_BUILD_GRADLE_USER_HOME=
APP_BUILD_XCODE_PACKAGES=
# 仅本地诊断可临时开启；production 环境即使误配也不会输出原始构建日志。
APP_BUILD_DEBUG_OUTPUT=false

# 仅首次初始化时临时设置，执行完成后从环境中删除。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-bytes
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
